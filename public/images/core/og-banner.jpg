<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800" fill="none">
  <defs>
    <linearGradient id="bg_gradient" x1="0" y1="0" x2="1200" y2="800" gradientUnits="userSpaceOnUse">
      <stop stop-color="#2A1454" stop-opacity="0.9"/>
      <stop offset="0.5" stop-color="#180A30"/>
      <stop offset="1" stop-color="#0E051D"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FFFFFF" stroke-opacity="0.05" stroke-width="1"/>
    </pattern>
    <linearGradient id="gold_grad" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#FCEEAC"/>
      <stop offset="0.5" stop-color="#D4AF37"/>
      <stop offset="1" stop-color="#996515"/>
    </linearGradient>
    <linearGradient id="violet_grad" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#9C1256"/>
      <stop offset="1" stop-color="#DE3F11"/>
    </linearGradient>
  </defs>
  
  <rect width="1200" height="800" fill="#130B24"/>
  <rect width="1200" height="800" fill="url(#bg_gradient)"/>
  <rect width="1200" height="800" fill="url(#grid)"/>
  
  <rect x="24" y="24" width="1152" height="752" rx="24" fill="none" stroke="#FFFFFF" stroke-opacity="0.1" stroke-width="2" stroke-dasharray="8 8"/>
  
  <g transform="translate(600, 400)">
    <circle r="100" fill="url(#violet_grad)" opacity="0.2"/>
    <circle r="56" fill="#241147" stroke="url(#gold_grad)" stroke-width="2"/>
    
    <g transform="translate(-20, -20)" stroke="url(#gold_grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <rect x="2" y="2" width="36" height="36" rx="6" ry="6"/>
      <circle cx="13" cy="13" r="3.5"/>
      <path d="M38 26L28 17L9 36"/>
    </g>
    
    <text y="90" text-anchor="middle" fill="#FFFFFF" font-family="system-ui, -apple-system, sans-serif" font-size="22" font-weight="700" letter-spacing="4">IMAGE PLACEHOLDER</text>
    <text y="118" text-anchor="middle" fill="#E2D9F3" fill-opacity="0.6" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="500" letter-spacing="1">LEADS NEXT-GEN CENTRE • RUAS</text>
  </g>
</svg>
