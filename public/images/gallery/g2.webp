<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800" fill="none">
  <defs>
    <linearGradient id="bg_gradient" x1="0" y1="0" x2="1200" y2="800" gradientUnits="userSpaceOnUse">
      <stop stop-color="#1E0E3D" stop-opacity="0.9"/>
      <stop offset="0.5" stop-color="#140827"/>
      <stop offset="1" stop-color="#0A0415"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FFFFFF" stroke-opacity="0.05" stroke-width="1"/>
    </pattern>
    <linearGradient id="gold_grad" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#FCEEAC"/>
      <stop offset="0.5" stop-color="#D4AF37"/>
      <stop offset="1" stop-color="#996515"/>
    </linearGradient>
    <linearGradient id="violet_grad" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#9C1256"/>
      <stop offset="1" stop-color="#DE3F11"/>
    </linearGradient>
  </defs>
  
  <rect width="1200" height="800" fill="#0D061A"/>
  <rect width="1200" height="800" fill="url(#bg_gradient)"/>
  <rect width="1200" height="800" fill="url(#grid)"/>
  
  <rect x="24" y="24" width="1152" height="752" rx="24" fill="none" stroke="#FFFFFF" stroke-opacity="0.08" stroke-width="2" stroke-dasharray="8 8"/>
  
  <g transform="translate(600, 400)">
    <circle r="90" fill="url(#violet_grad)" opacity="0.15"/>
    <circle r="52" fill="#1C0A38" stroke="url(#gold_grad)" stroke-width="2"/>
    
    <g transform="translate(-18, -18)" stroke="url(#gold_grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <rect x="2" y="2" width="32" height="32" rx="5" ry="5"/>
      <circle cx="11" cy="11" r="3"/>
      <path d="M34 23L25 15L8 32"/>
    </g>
    
    <text y="85" text-anchor="middle" fill="#FFFFFF" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" letter-spacing="4">GALLERY IMAGE PLACEHOLDER</text>
    <text y="112" text-anchor="middle" fill="#E2D9F3" fill-opacity="0.6" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="500" letter-spacing="1">LEADS NEXT-GEN CENTRE</text>
  </g>
</svg>
